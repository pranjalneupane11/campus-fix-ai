# Copy this file to .env (or export these as real environment variables) before running the backend.
# Never commit a real .env file - it is already in .gitignore.

DB_URL=jdbc:postgresql://localhost:5432/campus_fix_ai
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Get a key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

CORS_ALLOWED_ORIGINS=http://localhost:5173

SERVER_PORT=8080
